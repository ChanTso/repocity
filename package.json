{
  "name": "@repocity/web",
  "version": "0.2.0",
  "private": true,
  "description": "Turn a codebase into an explorable semantic city.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChanTso/repocity.git"
  },
  "bugs": {
    "url": "https://github.com/ChanTso/repocity/issues"
  },
  "homepage": "https://github.com/ChanTso/repocity#readme",
  "keywords": [
    "code-visualization",
    "repository-explorer",
    "semantic-city",
    "threejs"
  ],
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "assets:city-kit": "node scripts/generate-city-kit.mjs",
    "assets:city-kit-v2": "node scripts/generate-city-kit-v2.mjs",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:packages": "npm run build --workspaces --if-present",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "repocity": "tsx apps/cli/src/cli.ts",
    "fixture:tiny": "node fixtures/tiny-ts-repo/scripts/create-history.mjs",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces --if-present",
    "test:unit": "npm run test --workspaces --if-present && vitest run app/lib",
    "test:web": "node --test tests/rendered-html.test.mjs",
    "test": "npm run test:unit && npm run build && npm run test:web",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern fixtures --ignore-pattern public/projects",
    "check": "npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "commander": "^14.0.3",
    "lucide-react": "^0.468.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.179.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.50.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.179.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.2.0",
    "vitest": "^5.0.0",
    "wrangler": "4.118.0"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.2"
  },
  "type": "module"
}
